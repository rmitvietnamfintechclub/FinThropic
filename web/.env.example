# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key bypasses Row Level Security. Admin jobs and the worker only.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# AI models as provider:model. Optional; these are the defaults. Changing the embedding model means re-indexing every chunk.
AI_EMBEDDING_MODEL=google:gemini-embedding-001
AI_CHAT_MODEL=google:gemini-3.5-flash-lite
# POST /api/chat has no sign-in yet (until PBI-017). "true" only on your machine; leave it unset in production.
CHAT_API_ENABLED=false
